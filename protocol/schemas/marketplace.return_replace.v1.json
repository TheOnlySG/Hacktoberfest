{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ShopMart Return/Replace Request",
  "type": "object",
  "properties": {
    "order_id": { "type": "string" },
    "item_sku": { "type": "string" },
    "issue_type": { "type": "string", "enum": ["damaged_on_arrival", "missing_parts", "wrong_item"] },
    "requested_outcome": { "type": "string", "enum": ["replacement", "refund"] },
    "evidence": {
      "type": "object",
      "properties": {
        "invoice_attached": { "type": "boolean" },
        "photos_attached": { "type": "boolean" }
      }
    },
    "logistics": {
      "type": "object",
      "properties": {
        "pickup_address": { "type": "string" },
        "contact_window": { "type": "string" }
      }
    }
  },
  "required": ["order_id", "item_sku", "issue_type", "requested_outcome"]
}
